# Deployment settings kept in the project (not GitHub Secrets).
# The GitHub Actions workflow reads this file on every deploy.
# Fill in the three "replace-" values before the first run.

# Region of your AWS sandbox. The session token you provided indicates us-east-2.
# Change this if your lab uses a different region.
AWS_REGION=us-east-2

# CloudFormation stack name. Change it only if you want a separate stack.
STACK_NAME=fernwell-stack

# First admin account created by `npm run seed`.
ADMIN_EMAIL=admin@fernwell.com

# MongoDB connection string for the API. Include the database name (/fernwell).
# Example: mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/fernwell?retryWrites=true&w=majority
DB_URL=replace-with-your-mongodb-connection-string

# Long random string used to sign login tokens. Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string

# Password for the admin account above.
ADMIN_PASSWORD=replace-with-your-admin-password

# Note: these values are committed with the repository. Do not put real AWS keys here;
# AWS credentials stay in GitHub Secrets. If you prefer to keep DB/admin values private,
# move them to GitHub Secrets and update the workflow accordingly.
