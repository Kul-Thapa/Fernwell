# Deployment settings kept in the project (not GitHub Secrets).
# The GitHub Actions workflow reads this file on every deploy.

# Region of your AWS sandbox. The session token you provided indicates us-east-2.
AWS_REGION=us-east-2

# The EC2 instance created once in the AWS console. The workflow deploys to it.
# Find the ID in EC2 > Instances (looks like i-0123456789abcdef0).
INSTANCE_ID=replace-with-your-ec2-instance-id

# SSM Parameter Store name holding the PRIVATE .pem key for that instance.
# Store it as a SecureString, e.g. /fernwell/ec2-ssh-key. It is fetched at deploy time,
# so the private key is never committed and no extra GitHub Secret is needed.
SSH_KEY_PARAM=/fernwell/ec2-ssh-key

# First admin account created by `npm run seed`.
ADMIN_EMAIL=admin@fernwell.com

# MongoDB connection string. The bootstrap script installs MongoDB on the instance,
# so localhost works. For Atlas, use mongodb+srv://.../fernwell instead.
DB_URL=mongodb://127.0.0.1:27017/fernwell

# Secret used to sign login tokens. Change it to a longer random value for real use.
JWT_SECRET=kul-is-cool

# Password for the admin account above. Change it for real use.
ADMIN_PASSWORD=admin123

# Note: AWS credentials stay in GitHub Secrets. Do not put AWS keys here.
